---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import ProjectImage from './ProjectImage.astro';
import AnimatedThumb from './AnimatedThumb.astro';
import { hasThumb } from './thumbs';
import { normalizeMedia } from '../lib/media';
import { url } from '../scripts/url';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const visible = all.filter((p) => !p.data.hidden);

// Resolve the optional hover asset per project — either an image or a video.
type HoverMedia =
  | { kind: 'image'; img: import('astro').ImageMetadata }
  | { kind: 'video'; mp4: string; webm?: string; poster: string };
const hovers = new Map<string, HoverMedia>();
await Promise.all(
  visible.map(async (p) => {
    if (!p.data.hoverThumbnail) return;
    const m = normalizeMedia(p.data.hoverThumbnail);
    if (m.kind === 'image') {
      hovers.set(p.id, { kind: 'image', img: m.image });
    } else {
      const posterImg = m.poster ?? p.data.thumbnail;
      hovers.set(p.id, {
        kind: 'video',
        mp4: url(`/${m.src}`),
        webm: m.webm ? url(`/${m.webm}`) : undefined,
        poster: (await getImage({ src: posterImg, width: 760 })).src,
      });
    }
  })
);
---

<section class="px-6 md:px-10 lg:px-16 py-16 max-w-[1280px] mx-auto">
  <div class="flex items-baseline justify-between mb-0">
    <h2 class="font-display text-2xl text-ink">Selected Work</h2>
    <span class="font-mono text-xs text-ink-muted">
      {visible.length} projects
    </span>
  </div>

  <!-- Equal grid — every project gets the same card, so the section scales to
       any count without an orphaned half-row. -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24 gap-y-16 pt-10 border-t border-wire">
    {visible.map((project, i) => {
      const hm = hovers.get(project.id);
      return (
        <article class="reveal group">
          <a href={url(`/project/${project.id}/`)} class="block">
            <div class:list={['overflow-hidden mb-5', !hasThumb(project.id) && 'rounded-sm bg-panel']}>
              <AnimatedThumb slug={project.id} label={project.data.title} heightClass="h-[220px] md:h-[260px]">
                <ProjectImage
                  main={project.data.thumbnail}
                  hoverImage={hm?.kind === 'image' ? hm.img : undefined}
                  hoverVideo={hm?.kind === 'video' ? hm : undefined}
                  alt={project.data.title}
                  heightClass="h-[220px] md:h-[260px]"
                  widths={[620, 1240]}
                  sizes="(min-width: 768px) 45vw, 100vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </AnimatedThumb>
            </div>

            <p class="font-mono text-xs text-ink-muted mb-3">
              {String(i + 1).padStart(2, '0')} — {project.data.year}
            </p>
            <h3 class="font-display text-2xl md:text-3xl text-ink leading-tight mb-3 group-hover:text-pine transition-colors duration-200">
              {project.data.title}
            </h3>
            <p class="font-sans text-sm text-ink-muted leading-relaxed mb-4 max-w-[46ch]">
              {project.data.summary}
            </p>
            <p class="font-mono text-xs text-ink-muted">
              {project.data.techStack.slice(0, 4).join(' · ')}
            </p>
          </a>
        </article>
      );
    })}
  </div>

  <p class="font-mono text-xs text-ink-muted text-center pt-12">
    More coming soon — still writing them up 😅
  </p>
</section>
