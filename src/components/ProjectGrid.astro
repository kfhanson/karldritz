---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import ProjectImage from './ProjectImage.astro';
import { url } from '../scripts/url';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const visible = all.filter((p) => !p.data.hidden);
const featured = visible.filter((p) => p.data.featured);
const supporting = visible.filter((p) => !p.data.featured);

// Resolve the optional hover asset per project — either an image or a video.
type HoverMedia =
  | { kind: 'image'; img: import('astro').ImageMetadata }
  | { kind: 'video'; mp4: string; webm?: string; poster: string };
const hovers = new Map<string, HoverMedia>();
await Promise.all(
  visible.map(async (p) => {
    const h = p.data.hoverThumbnail;
    if (!h) return;
    if ('width' in h) {
      hovers.set(p.id, { kind: 'image', img: h });
    } else {
      const posterImg = h.poster ?? p.data.thumbnail;
      hovers.set(p.id, {
        kind: 'video',
        mp4: url(`/${h.src}`),
        webm: h.webm ? url(`/${h.webm}`) : undefined,
        poster: (await getImage({ src: posterImg, width: 760 })).src,
      });
    }
  })
);
---

<section class="px-6 md:px-10 lg:px-16 py-16 max-w-[1280px] mx-auto">
  <div class="flex items-baseline justify-between mb-0">
    <h2 class="font-display text-2xl text-ink">Selected Work</h2>
    <span class="font-mono text-xs text-ink-muted">
      {visible.length} projects
    </span>
  </div>

  <!-- Featured rows — alternating layout -->
  <div>
    {featured.map((project, i) => {
      const flip = i % 2 === 1;
      const hm = hovers.get(project.id);
      return (
        <div class="reveal grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-8 py-10 border-t border-wire">
          <div class:list={['md:col-span-7 overflow-hidden rounded-sm bg-panel', flip && 'md:order-last']}>
            <a href={url(`/project/${project.id}/`)} tabindex="-1" aria-hidden="true">
              <ProjectImage
                main={project.data.thumbnail}
                hoverImage={hm?.kind === 'image' ? hm.img : undefined}
                hoverVideo={hm?.kind === 'video' ? hm : undefined}
                alt={project.data.title}
                heightClass="h-[200px] md:h-[300px]"
                widths={[760, 1520]}
                sizes="(min-width: 768px) 60vw, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </a>
          </div>

          <div class:list={['md:col-span-5 flex flex-col justify-between py-1', flip && 'md:order-first']}>
            <div>
              <p class="font-mono text-xs text-ink-muted mb-3">
                {String(i + 1).padStart(2, '0')} — {project.data.year}
              </p>
              <a href={url(`/project/${project.id}/`)}>
                <h2 class="font-display text-3xl md:text-4xl text-ink leading-tight mb-3 hover:text-pine transition-colors duration-200">
                  {project.data.title}
                </h2>
              </a>
              <p class="font-sans text-sm text-ink-muted leading-relaxed mb-4">
                {project.data.summary}
              </p>
              <p class="font-mono text-xs text-ink-muted">
                {project.data.techStack.slice(0, 4).join(' · ')}
              </p>
            </div>
            <a
              href={url(`/project/${project.id}/`)}
              class="mt-6 inline-flex items-center gap-2 font-sans text-sm text-ink border-b border-ink pb-0.5 self-start hover:text-pine hover:border-pine transition-colors duration-200"
            >
              View case study <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Supporting grid -->
  {supporting.length > 0 && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-10 border-t border-wire">
      {supporting.map((project, i) => {
        const hm = hovers.get(project.id);
        return (
        <div class="reveal">
          <a href={url(`/project/${project.id}/`)} class="group block">
            <div class="overflow-hidden rounded-sm bg-panel mb-3">
              <ProjectImage
                main={project.data.thumbnail}
                hoverImage={hm?.kind === 'image' ? hm.img : undefined}
                hoverVideo={hm?.kind === 'video' ? hm : undefined}
                alt={project.data.title}
                heightClass="h-[160px]"
                widths={[620, 1240]}
                sizes="(min-width: 768px) 45vw, 100vw"
              />
            </div>
            <p class="font-mono text-xs text-ink-muted mb-2">
              {String(featured.length + i + 1).padStart(2, '0')} — {project.data.year}
            </p>
            <h3 class="font-display text-2xl text-ink mb-1 group-hover:text-pine transition-colors duration-200">
              {project.data.title}
            </h3>
            <p class="font-sans text-xs text-ink-muted">{project.data.category}</p>
          </a>
        </div>
        );
      })}
    </div>
  )}

  <p class="font-mono text-xs text-ink-muted text-center pt-12">
    More coming soon — still writing them up 😅
  </p>
</section>
