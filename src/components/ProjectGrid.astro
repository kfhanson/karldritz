---
import { Image } from 'astro:assets';
import { visibleProjects } from '../data/projects';
import { url } from '../scripts/url';

const featured = visibleProjects.filter(p => p.featured);
const supporting = visibleProjects.filter(p => !p.featured);
---

<section class="px-6 md:px-10 lg:px-16 py-24 max-w-[1280px] mx-auto">
  <div class="flex items-baseline justify-between mb-0">
    <h2 class="font-display text-2xl text-ink">Selected Work</h2>
    <span class="font-mono text-xs text-ink-muted">
      {featured.length + supporting.length} projects
    </span>
  </div>

  <!-- Featured rows — alternating layout -->
  <div>
    {featured.map((project, i) => {
      const flip = i % 2 === 1;
      return (
        <div class="reveal grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 py-16 border-t border-wire">
          <div class:list={['md:col-span-7 overflow-hidden rounded-sm bg-panel', flip && 'md:order-last']}>
            <a href={url(`/project/${project.slug}/`)} tabindex="-1" aria-hidden="true">
              <Image
                src={project.image}
                alt={project.title}
                widths={[760, 1520]}
                sizes="(min-width: 768px) 60vw, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="w-full h-[280px] md:h-[420px] object-cover hover:scale-[1.02] transition-transform duration-500"
              />
            </a>
          </div>

          <div class:list={['md:col-span-5 flex flex-col justify-between py-2', flip && 'md:order-first']}>
            <div>
              <p class="font-mono text-xs text-ink-muted mb-4">
                {String(i + 1).padStart(2, '0')} — {project.year}
              </p>
              <a href={url(`/project/${project.slug}/`)}>
                <h2 class="font-display text-4xl md:text-5xl text-ink leading-tight mb-4 hover:text-pine transition-colors duration-200">
                  {project.title}
                </h2>
              </a>
              <p class="font-sans text-sm text-ink-muted leading-relaxed mb-6">
                {project.description}
              </p>
              <p class="font-mono text-xs text-ink-muted">
                {project.techStack?.slice(0, 4).join(' · ')}
              </p>
            </div>
            <a
              href={url(`/project/${project.slug}/`)}
              class="mt-8 inline-flex items-center gap-2 font-sans text-sm text-ink border-b border-ink pb-0.5 self-start hover:text-pine hover:border-pine transition-colors duration-200"
            >
              View case study <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Supporting grid -->
  {supporting.length > 0 && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 pt-16 border-t border-wire">
      {supporting.map((project, i) => (
        <div class="reveal">
          <a href={url(`/project/${project.slug}/`)} class="group block">
            <div class="overflow-hidden rounded-sm bg-panel mb-4">
              <Image
                src={project.image}
                alt={project.title}
                widths={[620, 1240]}
                sizes="(min-width: 768px) 45vw, 100vw"
                loading="lazy"
                class="w-full h-[200px] object-cover group-hover:scale-[1.02] transition-transform duration-500"
              />
            </div>
            <p class="font-mono text-xs text-ink-muted mb-2">
              {String(featured.length + i + 1).padStart(2, '0')} — {project.year}
            </p>
            <h3 class="font-display text-2xl text-ink mb-1 group-hover:text-pine transition-colors duration-200">
              {project.title}
            </h3>
            <p class="font-sans text-xs text-ink-muted">{project.category}</p>
          </a>
        </div>
      ))}
    </div>
  )}
</section>
