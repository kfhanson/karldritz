---
// AV Simulation — cars evolved with NEAT lapping a 2D track. The lead car carries
// its distance-sensor rays; checkpoint gates tick as it passes; a small network in
// the corner keeps rewiring its topology.
interface Props { label: string }
const { label } = Astro.props;

// Closed loop, drawn once for the road and reused as the cars' motion path.
const TRACK =
  'M 120 150 C 120 80, 200 60, 300 70 C 380 78, 420 40, 520 50 C 640 62, 680 130, 640 190 ' +
  'C 605 245, 520 250, 440 235 C 380 224, 330 250, 260 245 C 170 238, 120 210, 120 150 Z';

// Checkpoint gates — short ticks placed across the road at hand-picked points.
const GATES = [
  { x: 300, y: 70,  r: 84 }, { x: 520, y: 50,  r: 96 }, { x: 664, y: 140, r: 10 },
  { x: 440, y: 235, r: 84 }, { x: 260, y: 245, r: 94 }, { x: 120, y: 150, r: 0 },
];

// Tiny NEAT graph: 3 inputs → 2 hidden → 4 outputs. Edges fade in/out to suggest
// topology mutating between generations.
const NODES = { in: [[580, 235], [580, 260], [580, 285]], hid: [[625, 245], [625, 275]], out: [[670, 232], [670, 250], [670, 268], [670, 286]] };
const EDGES: Array<[number[], number[], number]> = [
  [NODES.in[0], NODES.hid[0], 0], [NODES.in[1], NODES.hid[0], 1], [NODES.in[1], NODES.hid[1], 2], [NODES.in[2], NODES.hid[1], 3],
  [NODES.hid[0], NODES.out[0], 4], [NODES.hid[0], NODES.out[1], 5], [NODES.hid[1], NODES.out[2], 6], [NODES.hid[1], NODES.out[3], 7],
  [NODES.in[0], NODES.out[1], 8], [NODES.in[2], NODES.out[2], 9],
];
---

<svg viewBox="0 0 760 300" preserveAspectRatio="xMidYMid meet" role="img" aria-label={label} class="av">

  <!-- Track: outer edge, tarmac, centre line -->
  <path d={TRACK} class="av-edge" />
  <path d={TRACK} class="av-tarmac" />
  <path d={TRACK} class="av-centre" />

  <!-- Checkpoint gates -->
  <g class="av-gates">
    {GATES.map(({ x, y, r }, i) => (
      <line x1="-13" y1="0" x2="13" y2="0" transform={`translate(${x} ${y}) rotate(${r})`} style={`--i:${i}`} />
    ))}
  </g>

  <!-- Cars. The lead car (first) carries its sensor rays. -->
  <g class="av-cars">
    <g class="av-car av-lead" style="--d: 12s; --o: 0s">
      <g class="av-rays">
        <line x1="0" y1="0" x2="52" y2="0" />
        <line x1="0" y1="0" x2="46" y2="-18" />
        <line x1="0" y1="0" x2="46" y2="18" />
        <line x1="0" y1="0" x2="30" y2="-32" />
        <line x1="0" y1="0" x2="30" y2="32" />
      </g>
      <rect x="-8" y="-4" width="16" height="8" rx="2" />
    </g>
    <g class="av-car" style="--d: 13.5s; --o: -4s"><rect x="-8" y="-4" width="16" height="8" rx="2" /></g>
    <g class="av-car" style="--d: 15s;   --o: -9s"><rect x="-8" y="-4" width="16" height="8" rx="2" /></g>
  </g>

  <!-- NEAT topology -->
  <g class="av-net">
    {EDGES.map(([a, b, i]) => <line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} style={`--i:${i}`} />)}
    {[...NODES.in, ...NODES.hid, ...NODES.out].map(([x, y], i) => <circle cx={x} cy={y} r="3" style={`--i:${i}`} />)}
  </g>
</svg>

<style>
  .av-edge   { fill: none; stroke: var(--color-ink-muted); stroke-width: 30; opacity: 0.35; }
  .av-tarmac { fill: none; stroke: var(--color-wire); stroke-width: 26; }
  .av-centre { fill: none; stroke: var(--color-ink-muted); stroke-width: 1; stroke-dasharray: 8 10; opacity: 0.4; }

  .av-gates line {
    stroke: var(--color-pine);
    stroke-width: 2;
    opacity: 0.35;
    animation: av-gate 12s ease-out infinite;
    animation-delay: calc(var(--i) * 2s);
  }
  @keyframes av-gate {
    0%, 6%   { opacity: 1; }
    14%,100% { opacity: 0.35; }
  }

  .av-car { display: none; }
  .av-car rect { fill: var(--color-ink); }
  .av-lead rect { fill: var(--color-pine); }
  .av-rays line { stroke: var(--color-pine); stroke-width: 1; opacity: 0.55; }
  @supports (offset-path: path('M 0 0 H 1')) {
    .av-car {
      display: block;
      offset-path: path('M 120 150 C 120 80, 200 60, 300 70 C 380 78, 420 40, 520 50 C 640 62, 680 130, 640 190 C 605 245, 520 250, 440 235 C 380 224, 330 250, 260 245 C 170 238, 120 210, 120 150 Z');
      offset-rotate: auto;
      animation: av-lap var(--d) linear infinite;
      animation-delay: var(--o);
    }
  }
  @keyframes av-lap {
    from { offset-distance: 0%; }
    to   { offset-distance: 100%; }
  }

  .av-net line {
    stroke: var(--color-ink-muted);
    stroke-width: 1;
    opacity: 0.5;
    animation: av-edge 8s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.8s);
  }
  @keyframes av-edge {
    0%, 55%  { opacity: 0.5; }
    65%, 85% { opacity: 0.05; }
    95%      { opacity: 0.5; }
  }
  .av-net circle {
    fill: var(--color-pine);
    animation: av-node 2.4s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.27s);
  }
  @keyframes av-node {
    0%, 100% { opacity: 0.45; }
    50%      { opacity: 1; }
  }
</style>
