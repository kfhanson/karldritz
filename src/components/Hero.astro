---
import { url } from '../scripts/url';

// Headline words animate in one at a time, left to right, line by line.
const HEADLINE = [['I', 'build', 'AI'], ['that', 'learns'], ['from', 'the', 'world.']];
const WORD_START = 0.9;
const WORD_STAGGER = 0.08;

let wordIndex = 0;
const headline = HEADLINE.map((line) =>
  line.map((word) => ({ word, delay: (WORD_START + wordIndex++ * WORD_STAGGER).toFixed(2) }))
);
---

<section
  aria-label="Introduction"
  class="hero-intro relative min-h-screen flex flex-col justify-end pb-16 px-6 md:px-10 lg:px-16 pt-32 overflow-hidden bg-[#0a0a0a]"
>
  <canvas data-shader aria-hidden="true" class="shader-fade absolute inset-0 w-full h-full pointer-events-none"></canvas>

  <div class="relative z-10 max-w-[1280px] mx-auto w-full">
    <p class="fade-up font-mono text-xs text-white/50 uppercase tracking-widest mb-8" style="--d: 0.8s">
      Applied AI — Jakarta, Indonesia
    </p>

    <h1 class="font-display text-[clamp(3.5rem,9vw,8.5rem)] leading-[0.92] tracking-tight text-white mb-10">
      {headline.map((line) => (
        <span class="line-mask">
          {line.map(({ word, delay }) => (
            <Fragment><span class="word-mask"><span style={`--d: ${delay}s`}>{word}</span></span>{' '}</Fragment>
          ))}
        </span>
      ))}
    </h1>

    <div class="fade-up flex flex-col md:flex-row md:items-end justify-between gap-8 border-t border-white/15 pt-8" style="--d: 1.7s">
      <p class="font-sans text-sm text-white/60 max-w-sm leading-relaxed">
        I'm Karldritz Hanson — reinforcement learning, agentic systems, and applied AI for the real world.
        <br />
        AI Engineer Intern at Sertis Teknologi Indonesia.
      </p>
      <div class="flex items-center gap-6 flex-shrink-0">
        <a
          href={url('/about/')}
          class="font-sans text-sm text-white/70 border-b border-white/30 pb-0.5 hover:text-white hover:border-white transition-colors duration-200"
        >
          About me
        </a>
        <a
          href="mailto:kfhanson.2508@gmail.com"
          class="font-sans text-sm text-white/70 border-b border-white/30 pb-0.5 hover:text-white hover:border-white transition-colors duration-200"
        >
          Get in touch
        </a>
      </div>
    </div>
  </div>
</section>
