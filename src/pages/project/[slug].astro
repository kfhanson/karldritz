---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects, visibleProjects } from '../../data/projects';
import { url } from '../../scripts/url';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const projectIndex = projects.findIndex(p => p.slug === project.slug);

// Cycle "Next project" through visible projects only
const visibleIndex = visibleProjects.findIndex(p => p.slug === project.slug);
const nextProject =
  visibleProjects[(Math.max(visibleIndex, 0) + 1) % visibleProjects.length] ?? visibleProjects[0];

const ogImage = (await getImage({ src: project.image, width: 1200 })).src;
---

<Base
  title={`${project.title} — Karldritz Farrel Hanson`}
  description={project.description ?? `${project.title} — a project by Karldritz Farrel Hanson.`}
  ogImage={ogImage}
>
  <main id="main-content" class="min-h-screen bg-canvas text-ink pt-32 pb-24 px-6 md:px-10 lg:px-16">
    <div class="max-w-[1280px] mx-auto">

      <!-- Back -->
      <a
        href={url('/')}
        class="inline-flex items-center gap-2 font-sans text-sm text-ink-muted hover:text-ink transition-colors duration-200 mb-16"
      >
        ← Back
      </a>

      <!-- Header -->
      <header class="mb-20">
        <p class="fade-up font-mono text-xs text-ink-muted mb-4">
          {String(projectIndex + 1).padStart(2, '0')} — {project.category}
        </p>
        <h1 class="fade-up fade-up-1 font-display text-6xl md:text-8xl lg:text-9xl text-ink leading-[0.9] mb-12">
          {project.title}
        </h1>

        <div class="fade-up fade-up-2 grid grid-cols-2 md:grid-cols-4 gap-8 border-t border-wire pt-8">
          <div>
            <h5 class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-2">Role</h5>
            <p class="font-sans text-sm text-ink">{project.role ?? 'Developer'}</p>
          </div>
          <div>
            <h5 class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-2">Year</h5>
            <p class="font-sans text-sm text-ink">{project.year}</p>
          </div>
          <div>
            <h5 class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-2">Stack</h5>
            <p class="font-sans text-sm text-ink leading-relaxed">
              {project.techStack?.join(', ')}
            </p>
          </div>
          <div class="flex items-start justify-start md:justify-end gap-3 flex-wrap">
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noreferrer"
                class="font-sans text-xs text-ink border border-wire rounded-full px-4 py-2 hover:bg-ink hover:text-canvas hover:border-ink transition-colors duration-200"
              >
                Live site
              </a>
            )}
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noreferrer"
                class="font-sans text-xs text-ink border border-wire rounded-full px-4 py-2 hover:bg-ink hover:text-canvas hover:border-ink transition-colors duration-200"
              >
                GitHub
              </a>
            )}
          </div>
        </div>
      </header>

      <!-- Hero image -->
      <div class="w-full h-[50vh] md:h-[70vh] bg-panel overflow-hidden rounded-sm mb-20">
        <Image
          src={project.image}
          alt={project.title}
          widths={[1280, 1800]}
          sizes="100vw"
          loading="eager"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Body copy -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-24">
        <div class="md:col-span-7 md:col-start-3">
          <h3 class="font-display text-xl text-ink mb-8">About the project</h3>
          <div class="space-y-6 font-sans text-base text-ink-muted leading-relaxed">
            {project.fullDescription
              ? project.fullDescription.map((paragraph) => <p>{paragraph}</p>)
              : <p>{project.description}</p>}
          </div>
        </div>
      </div>

      <!-- Next project -->
      <div class="border-t border-wire pt-12 flex items-center justify-between">
        <span class="font-mono text-xs text-ink-muted uppercase tracking-widest">Next project</span>
        <a
          href={url(`/project/${nextProject.slug}/`)}
          class="font-display text-2xl md:text-4xl text-ink hover:text-pine transition-colors duration-200"
        >
          {nextProject.title} <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </main>
</Base>
