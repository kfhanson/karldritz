---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../scripts/url';
import { normalizeMedia } from '../../lib/media';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order
  );
  // Mirror the home grid's ordering exactly — featured block first, then the
  // rest — so a card labelled "02" opens a page whose header also reads "02".
  const visible = projects.filter((p) => !p.data.hidden);
  const ordered = [
    ...visible.filter((p) => p.data.featured),
    ...visible.filter((p) => !p.data.featured),
  ];
  // Hidden projects are still built (direct link only); they number after the
  // visible ones so they never collide with a grid number.
  const hidden = projects.filter((p) => p.data.hidden);

  return projects.map((entry) => {
    const vi = ordered.findIndex((p) => p.id === entry.id);
    const displayNumber =
      vi === -1
        ? ordered.length + hidden.findIndex((p) => p.id === entry.id) + 1
        : vi + 1;
    // "Next project" cycles through visible projects only, in grid order.
    const nextProject =
      vi === -1 ? ordered[0] : ordered[(vi + 1) % ordered.length];
    return {
      params: { slug: entry.id },
      props: { entry, displayNumber, nextProject },
    };
  });
}

const { entry, displayNumber, nextProject } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const ogImage = (await getImage({ src: data.thumbnail, width: 1200 })).src;

// Unified link list: the convenience fields first, then any custom links.
const projectLinks = [
  data.link && { label: 'Live site', url: data.link },
  data.paper && { label: 'Paper', url: data.paper },
  data.github && { label: 'GitHub', url: data.github },
  ...data.links,
].filter(Boolean) as { label: string; url: string }[];

const linksHeading =
  data.type === 'competition' ? 'Sources' : data.type === 'research' ? 'Resources' : 'Links';

// Gallery media — mixed images + videos, or the main image alone. Each slide
// carries a caption (shown under the strip and on its collapsed tab) and an
// object-fit mode.
const carousel = data.gallery.length ? data.gallery : [data.thumbnail];
const slidesData = await Promise.all(
  carousel.map(async (raw, i) => {
    const m = normalizeMedia(raw);
    const caption = m.caption ?? (carousel.length === 1 ? data.title : `${data.title} — ${i + 1}`);
    if (m.kind === 'image') return { kind: 'image' as const, image: m.image, caption, fit: m.fit };
    return {
      kind: 'video' as const,
      mp4: url(`/${m.src}`),
      webm: m.webm ? url(`/${m.webm}`) : undefined,
      poster: m.poster ? (await getImage({ src: m.poster, width: 1280 })).src : undefined,
      caption,
      fit: m.fit,
    };
  })
);
const pad2 = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={`${data.title} — Karldritz Farrel Hanson`}
  description={data.summary}
  ogImage={ogImage}
>
  <main id="main-content" class="min-h-screen bg-canvas text-ink pt-32 pb-24 px-6 md:px-10 lg:px-16">
    <div class="max-w-[1280px] mx-auto">

      <!-- Back -->
      <a
        href={url('/')}
        class="inline-flex items-center gap-2 font-sans text-sm text-ink-muted hover:text-ink transition-colors duration-200 mb-10"
      >
        ← Back
      </a>

      <!-- Header -->
      <header class="mb-8">
        <p class="fade-up font-mono text-xs text-ink-muted mb-4">
          {String(displayNumber).padStart(2, '0')} — {data.category}
          {data.type !== 'project' && (
            <span class="text-pine"> · {data.type === 'competition' ? 'Competition' : 'Research'}</span>
          )}
        </p>
        <h1 class="fade-up fade-up-1 font-display text-5xl md:text-7xl text-ink leading-[0.95]">
          {data.title}
        </h1>
      </header>

      <!-- Gallery — horizontal accordion: the active slide takes the width, the
           rest collapse into labelled tabs. Driven by initCoverflow() in main.ts. -->
      <div class="coverflow-wrap mb-12">
        <div id="coverflow" data-count={slidesData.length} class="coverflow w-full">
          <div class="coverflow-track" data-track>
            {slidesData.map((m, i) => (
              <div class="coverflow-card" data-slide={i} data-fit={m.fit} data-caption={m.caption}>
                {m.kind === 'video' ? (
                  <video data-cf-video muted loop playsinline preload="metadata" poster={m.poster}>
                    {m.webm && <source src={m.webm} type="video/webm" />}
                    <source src={m.mp4} type="video/mp4" />
                  </video>
                ) : (
                  <Image
                    src={m.image}
                    alt={m.caption}
                    widths={[700, 1400]}
                    sizes="(min-width: 768px) 80vw, 100vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                )}
                <span class="cf-tab" aria-hidden="true">{m.caption}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="cf-bar">
          <p class="cf-caption font-mono text-xs text-ink-muted" data-cf-caption aria-live="polite">
            {slidesData.length > 1 && (
              <>
                <span class="text-ink" data-cf-index>{pad2(1)} / {pad2(slidesData.length)}</span>
                <span> — </span>
              </>
            )}
            <span data-cf-text>{slidesData[0].caption}</span>
          </p>
          {slidesData.length > 1 && (
            <div class="flex items-center gap-2 flex-shrink-0">
              <button id="cf-prev" type="button" aria-label="Previous slide" class="cf-btn">‹</button>
              <button id="cf-next" type="button" aria-label="Next slide" class="cf-btn">›</button>
            </div>
          )}
        </div>
      </div>

      <!-- Sticky sidebar + case-study body -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-x-12 gap-y-10 mb-24">

        <aside class="md:col-span-4 lg:col-span-3">
          <div class="md:sticky md:top-28 space-y-8">

            <!-- Meta -->
            <dl class="grid grid-cols-2 gap-x-8 gap-y-6 md:grid-cols-1">
              <div>
                <dt class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-2">Role</dt>
                <dd class="font-sans text-sm text-ink">{data.role}</dd>
              </div>
              <div>
                <dt class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-2">Year</dt>
                <dd class="font-sans text-sm text-ink">{data.year}</dd>
              </div>
              <div class="col-span-2 md:col-span-1">
                <dt class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-2">Stack</dt>
                <dd class="font-sans text-sm text-ink leading-relaxed">{data.techStack.join(', ')}</dd>
              </div>
            </dl>

            <!-- Metrics -->
            {data.metrics.length > 0 && (
              <div class="border-t border-wire pt-6 space-y-4">
                {data.metrics.map((m) => (
                  <div>
                    <p class="font-display text-lg text-ink leading-tight">{m.value}</p>
                    <p class="font-mono text-[10px] text-ink-muted uppercase tracking-widest">{m.label}</p>
                  </div>
                ))}
              </div>
            )}

            <!-- Links / sources -->
            {projectLinks.length > 0 && (
              <div class="border-t border-wire pt-6">
                <h2 class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-3">{linksHeading}</h2>
                <div class="flex flex-wrap gap-2">
                  {projectLinks.map((l) => (
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-1.5 font-sans text-xs text-ink border border-wire rounded-full px-3 py-1.5 hover:bg-ink hover:text-canvas hover:border-ink transition-colors duration-200"
                    >
                      {l.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </div>
            )}

          </div>
        </aside>

        <article class="md:col-span-8 lg:col-span-8 lg:col-start-4 case-study">
          <Content />
        </article>
      </div>

      <!-- Next project -->
      <div class="border-t border-wire pt-12 flex items-center justify-between">
        <span class="font-mono text-xs text-ink-muted uppercase tracking-widest">Next project</span>
        <a
          href={url(`/project/${nextProject.id}/`)}
          class="font-display text-2xl md:text-4xl text-ink hover:text-pine transition-colors duration-200"
        >
          {nextProject.data.title} <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </main>
</Base>
