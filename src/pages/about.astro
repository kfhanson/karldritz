---
import Base from '../layouts/Base.astro';

// One chronology: professional work (filled node); volunteer, leadership and
// education (hollow node).
// `present` adds the pulsing ring.
type Kind = 'work' | 'volunteer' | 'lead' | 'edu';
const timeline: Array<{ period: string; org: string; role: string; kind: Kind; note?: string; present?: boolean }> = [
  { period: 'Apr 2026 — Present', org: 'Sertis Teknologi Indonesia', role: 'AI Engineer', kind: 'work', present: true,
    note: 'Enterprise LLMs and knowledge management.' },
  { period: 'Jan 2026 — Jul 2026', org: 'TemuCita', role: 'Full Stack Engineer · Volunteer', kind: 'volunteer',
    note: 'Cita — an AI companion with RAG and memory for a mental-health community.' },
  { period: 'Sep 2025 — Mar 2026', org: 'Huawei Cloud Indonesia', role: 'Solution Architect Intern', kind: 'work',
    note: 'Cost-efficient solution architectures; migrated a major telco to Huawei Cloud.' },
  { period: 'Spring 2025', org: 'Chang Gung University, Taiwan', role: 'Exchange semester · 4.0 GPA', kind: 'edu' },
  { period: '2024 — 2025', org: 'BINUS University', role: 'Student Mentor', kind: 'lead' },
  { period: '2023 — 2025', org: 'HIMTI', role: 'Academic Events Activist · Chair, HILET 2024', kind: 'lead',
    note: 'Seminars, workshops and event operations; led and coordinated HILET 2024.' },
  { period: 'Aug 2022 — Jan 2023', org: 'Digdaya Duta Digital', role: 'Research Intern', kind: 'work',
    note: 'E-learning codebase analysis; report on AI/ML for business development.' },
  { period: 'May 2021 — May 2022', org: 'Cyberindo Aditama', role: 'Research Intern', kind: 'work',
    note: 'Researched student behaviour in online learning; proposed a learning-focused device.' },
];

const researchSkills = ['PyTorch', 'TensorFlow', 'Keras', 'Stable-Baselines3', 'RLlib', 'SUMO', 'NEAT', 'PyGame', 'LangChain', 'Scikit-learn', 'Pandas', 'NumPy', 'Weights & Biases'];
const systemsSkills = ['Huawei Cloud', 'AWS Lambda', 'SageMaker', 'GCP', 'Docker', 'Kubernetes', 'Git', 'GitHub Actions', 'PostgreSQL', 'MongoDB', 'Express.js', 'Nginx', 'Power BI'];

const certifications = [
  { name: 'Huawei Certified ICT Associate – Cloud Service', year: '2025' },
  { name: 'Alibaba Cloud Associate (ACA) – Cloud Computing', year: '2024' },
  { name: 'NVIDIA – Fundamentals of Deep Learning', year: '2024' },
  { name: 'IELTS 7.5 Band Score', year: '2024' },
];
---

<Base
  title="About — Karldritz Farrel Hanson"
  description="About Karldritz Farrel Hanson — Computer Science student at BINUS University and AI Engineer at Sertis Teknologi Indonesia, working on reinforcement learning and LLM agent systems."
>
  <main id="main-content" class="min-h-screen pt-32 px-6 md:px-10 lg:px-16 pb-24">
    <div class="max-w-[1280px] mx-auto">

      <!-- Split per character so the reveal can stagger them out of their
           masks. aria-label keeps it a single word for screen readers. -->
      <h1
        data-about-title
        aria-label="About"
        class="font-display text-6xl md:text-8xl text-ink mb-16 leading-[0.9]"
      >
        {[...'About'].map((char, i) => (
          <span class="char-mask" aria-hidden="true"><span style={`--i:${i}`}>{char}</span></span>
        ))}
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-16 md:gap-24">

        <!-- Left: Bio + Contact -->
        <div class="md:col-span-4 space-y-12">

          <div class="cascade">
            <p class="font-sans text-base text-ink leading-relaxed">
              I build reinforcement learning and agentic systems that work in the real world.
            </p>
            <p class="font-sans text-sm text-ink-muted leading-relaxed mt-4">
              Currently building AI solutions for enterprises at Sertis Teknologi Indonesia. Computer Science student at BINUS University, Jakarta — graduating in 2026. I also often participate in hackathons and do fun side-projects.
            </p>
          </div>

          <div class="cascade">
            <h3 class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-4">Based in</h3>
            <p class="font-sans text-sm text-ink">Jakarta, Indonesia</p>
          </div>

          <div class="cascade">
            <h3 class="font-mono text-xs text-ink-muted uppercase tracking-widest mb-4">Contact</h3>
            <ul class="font-sans text-sm text-ink space-y-2">
              <li>
                <a
                  href="mailto:kfhanson.2508@gmail.com"
                  class="hover:text-pine transition-colors duration-200 border-b border-transparent hover:border-pine pb-0.5"
                >
                  kfhanson.2508@gmail.com
                </a>
              </li>
              <li>
                <a
                  href="https://linkedin.com/in/karldritz"
                  target="_blank"
                  rel="noreferrer"
                  aria-label="LinkedIn profile (opens in new tab)"
                  class="hover:text-pine transition-colors duration-200 border-b border-transparent hover:border-pine pb-0.5"
                >
                  LinkedIn /karldritz
                </a>
              </li>
              <li>
                <a
                  href="https://github.com/kfhanson"
                  target="_blank"
                  rel="noreferrer"
                  aria-label="GitHub profile (opens in new tab)"
                  class="hover:text-pine transition-colors duration-200 border-b border-transparent hover:border-pine pb-0.5"
                >
                  GitHub /kfhanson
                </a>
              </li>
            </ul>
          </div>

        </div>

        <!-- Right: Experience, Skills, Certs, Writing -->
        <div class="md:col-span-8 space-y-16">

          <!-- Experience — scroll-driven timeline (initTimeline in main.ts) -->
          <div class="cascade">
            <div class="flex items-baseline justify-between gap-4 border-b border-wire pb-4 mb-8">
              <h2 class="font-display text-2xl text-ink">Experience</h2>
              <p class="font-mono text-[10px] text-ink-muted uppercase tracking-widest flex gap-5" aria-hidden="true">
                <span><i class="tl-key tl-key-work"></i>Work</span>
                <span><i class="tl-key"></i>Volunteer · Leadership · Education</span>
              </p>
            </div>

            <div class="tl" data-timeline>
              <div class="tl-spine" aria-hidden="true"><div class="tl-spine-fill"></div></div>
              <ol class="tl-list">
                {timeline.map((e) => (
                  <li class="tl-item" data-kind={e.kind} data-present={e.present ? 'true' : undefined}>
                    <div class="tl-gutter" aria-hidden="true">
                      <span class="tl-node"><span class="tl-pulse"></span></span>
                    </div>
                    <div class="tl-body">
                      <p class="font-mono text-xs text-ink-muted mb-1">{e.period}</p>
                      <h4 class="font-sans text-base text-ink leading-snug">
                        <span class="font-medium">{e.org}</span>
                        <span class="text-ink-muted"> · {e.role}</span>
                      </h4>
                      {e.note && (
                        <p class="font-sans text-sm text-ink-muted leading-relaxed mt-2 md:truncate">{e.note}</p>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <!-- Skills -->
          <div class="cascade">
            <h2 class="font-display text-2xl text-ink border-b border-wire pb-4 mb-6">
              Skills
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">

              <!-- Research stack — 2/3 width -->
              <div class="col-span-2 bg-white border border-wire rounded-2xl p-5">
                <p class="font-mono text-[10px] text-ink-muted uppercase tracking-widest mb-3">Research</p>
                <div class="flex flex-wrap gap-1.5">
                  {researchSkills.map(t => (
                    <span class="font-mono text-[11px] bg-canvas border border-wire px-2.5 py-1 rounded-full text-ink">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Current focus — 1/3 width, pine accent -->
              <div class="col-span-1 bg-pine rounded-2xl p-5 flex flex-col justify-between min-h-[120px]">
                <p class="font-mono text-[10px] text-white/50 uppercase tracking-widest">Focus</p>
                <div>
                  <p class="font-display text-3xl text-white leading-tight mb-2">LLM Systems</p>
                  <p class="font-sans text-[11px] text-white/60 leading-snug">Enterprise AI · Real-world applications</p>
                </div>
              </div>

              <!-- Languages — 1/3 width -->
              <div class="col-span-1 bg-panel border border-wire/60 rounded-2xl p-5">
                <p class="font-mono text-[10px] text-ink-muted uppercase tracking-widest mb-2">Languages</p>
                <p class="font-display text-4xl text-ink leading-none mb-2">10+</p>
                <p class="font-mono text-[10px] text-ink-muted leading-relaxed">
                  Python · TypeScript<br />Go · R · SQL · C · C++
                </p>
              </div>

              <!-- Systems — 2/3 width -->
              <div class="col-span-2 bg-white border border-wire rounded-2xl p-5">
                <p class="font-mono text-[10px] text-ink-muted uppercase tracking-widest mb-3">Systems & Cloud</p>
                <div class="flex flex-wrap gap-1.5">
                  {systemsSkills.map(t => (
                    <span class="font-mono text-[11px] bg-canvas border border-wire px-2.5 py-1 rounded-full text-ink">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

            </div>
          </div>

          <!-- Certifications -->
          <div class="cascade">
            <h2 class="font-display text-2xl text-ink border-b border-wire pb-4 mb-8">
              Certifications
            </h2>
            <ul class="space-y-0">
              {certifications.map(cert => (
                <li class="flex items-baseline justify-between gap-4 border-b border-wire py-3">
                  <span class="font-sans text-sm text-ink">{cert.name}</span>
                  <span class="font-mono text-xs text-ink-muted flex-shrink-0">{cert.year}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Writing -->
          <div class="cascade">
            <h2 class="font-display text-2xl text-ink border-b border-wire pb-4 mb-8">
              Writing
            </h2>
            <div class="font-sans text-sm text-ink-muted leading-relaxed">
              <p class="italic text-ink mb-2">
                "Simulation-Based Optimization of Autonomous Vehicles Using Genetic Algorithm"
              </p>
              <p class="mb-1">K. F. Hanson, K. K. Al Biruni, Anderies, A. Chowanda</p>
              <p class="mb-4">
                2024 6th International Conference on Cybernetics and Intelligent System (ICORIS)
              </p>
              <a
                href="https://doi.org/10.1109/ICORIS63540.2024.10903833"
                target="_blank"
                rel="noreferrer"
                aria-label="DOI link for ICORIS 2024 paper (opens in new tab)"
                class="font-mono text-xs text-pine hover:underline"
              >
                doi:10.1109/ICORIS63540.2024.10903833 →
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>
</Base>
